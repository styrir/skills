# /generate skill — API keys
# Copy this file to ~/.config/generate/.env, fill in real keys, then:
#   chmod 600 ~/.config/generate/.env
# Never commit real keys to any repo.

KIE_API_KEY=your_key_here        # kie.ai — often the cheapest route for popular models; handy file upload for local refs
FAL_KEY=your_key_here            # fal.ai — fast, huge catalog, best docs; first fallback
WAVESPEED_API_KEY=your_key_here  # wavespeed.ai — broad catalog; second fallback (no recipe wired yet)
GEMINI_API_KEY=your_key_here     # aistudio.google.com — Nano Banana 2 + Veo 3.1 direct (Google AI Studio)
