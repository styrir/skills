# Summarization provider
# Recommended default: auto = use local/remote OpenAI-compatible model when configured,
# otherwise prefer an agent subprocess backend when configured and finally fall back to deterministic outline mode.
SETJA_SUMMARIZER=auto
SETJA_LLM_BASE_URL=
SETJA_LLM_API_KEY=
SETJA_LLM_MODEL=
SETJA_VISION_MODEL=
# Optional explicit subprocess backend pin. In auto mode, Setja can infer codex
# automatically when `codex` is available on PATH.
SETJA_AGENT_BACKEND=
SETJA_AGENT_MODEL=

# Optional Rúnir integration
SETJA_RUNIR_ENABLED=false
SETJA_RUNIR_BASE_URL=http://localhost:3000
SETJA_RUNIR_CAPTURE_PATH=/hooks/capture
SETJA_RUNIR_RECALL_PATH=/hooks/recall
SETJA_RUNIR_API_KEY=
